#include <iostream>
using namespace std;
int main(){
     int arr[5]={1,26,3,34,5};
     int largest=arr[0];
     int second_largest=arr[0];
     for(int i=1;i<5;i++){
         if(arr[i]>largest){
             second_largest=largest;
             largest=arr[i];
         }
         
     }
     cout<<second_largest;
}